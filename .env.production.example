MONGO_PASSWORD=change_me_with_a_strong_database_password
JWT_SECRET=change_me_with_a_unique_64_character_jwt_secret_value
JWT_REFRESH_SECRET=change_me_with_a_unique_64_character_refresh_secret_value
FRONTEND_URL=https://your-domain.example
NODE_ENV=production

# Public frontend build setting. Rebuild the frontend after changing it.
# local: browser-only certificates; server: signed, persisted final assessments.
VITE_CERTIFICATE_MODE=local

# Backend only. Optional empty values keep public issuance/verification disabled.
# Use an independent, stable random secret of at least 32 characters; never a VITE_* variable.
CERTIFICATE_SIGNING_SECRET=
# Origin only: real public HTTPS domain, no path, query, fragment or credentials.
# When ready, set this to the same origin as FRONTEND_URL, for example https://your-domain.example
CERTIFICATE_PUBLIC_URL=
