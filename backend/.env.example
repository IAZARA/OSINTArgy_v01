# Configuración del servidor
NODE_ENV=development
PORT=3001
HOST=localhost

# Base de datos
MONGODB_URI=mongodb://localhost:27017/osintargy

# JWT
JWT_SECRET=change_me_with_a_strong_32_character_secret
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=change_me_with_a_strong_refresh_secret
JWT_REFRESH_EXPIRE=7d

# Frontend URL para CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=1mb

# Archivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Email (opcional)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@osintargy.com

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Cache
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# APIs externas (opcional)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# Seguridad
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=7200000
PASSWORD_RESET_EXPIRE=3600000

# Aplicación
APP_HOMEPAGE=
SUPPORT_EMAIL=soporte@osintargy.online

# Desarrollo
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change_me_before_seeding
ENABLE_SWAGGER=true
ENABLE_CORS=true
LOG_REQUESTS=true

# Emisión pública opcional. Clave independiente, estable y de al menos 32 caracteres.
# Nunca incluir la clave en variables VITE_ ni en Git.
CERTIFICATE_SIGNING_SECRET=
# Origen público HTTPS del frontend, sin barra final.
CERTIFICATE_PUBLIC_URL=
# Solo detrás de un proxy de confianza que sobrescribe X-Forwarded-For.
TRUST_PROXY=0
